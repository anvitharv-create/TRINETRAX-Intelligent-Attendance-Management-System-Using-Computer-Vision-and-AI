# ---------------------------------------------------------------------------
# TrinetraX - WhatsApp parent-report delivery
#
# HOW TO USE
#   1. Copy this file to ".env" (same folder).
#   2. Paste your real values after the "=" signs.
#   3. Restart the backend.
#
# The ".env" file holds SECRETS - never share it or upload it anywhere.
# Any value left empty keeps WhatsApp delivery switched off, and the app will
# honestly report "Not configured" instead of pretending a message was sent.
# ---------------------------------------------------------------------------

# Must be exactly: whatsapp_cloud_api
WHATSAPP_PROVIDER=

# Meta permanent access token (from Meta for Developers > your app > API Setup)
WHATSAPP_TOKEN=

# The WhatsApp Business phone number id (also on the API Setup page)
WHATSAPP_PHONE_NUMBER_ID=

# Optional - Meta API version to call. Defaults to v20.0.
WHATSAPP_API_VERSION=

# Optional - seconds to pause between real sends, to stay under rate limits.
WHATSAPP_SEND_DELAY_SECONDS=

# Optional - max students per batch. Defaults to 500.
PARENT_REPORT_MAX_BATCH=


# ---------------------------------------------------------------------------
# EMAIL CHANNEL (the easy one - no company verification required)
#
# For Gmail: turn on 2-Step Verification on the Google account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and paste that
# 16-character string as SMTP_PASSWORD. Your normal Google password will NOT
# work. This takes about two minutes and needs no business documents.
# ---------------------------------------------------------------------------
# Must be exactly: smtp
EMAIL_PROVIDER=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail address that sends the reports
SMTP_USERNAME=

# The 16-character Gmail App Password (NOT your real Google password)
SMTP_PASSWORD=

# The From address shown to the recipient. Usually the same as SMTP_USERNAME.
SMTP_FROM=

# "1" (default) enables STARTTLS, which Gmail requires. Set to 0 only for a
# local test relay.
SMTP_USE_TLS=

# Optional - the friendly From name parents/students will see.
EMAIL_SENDER_NAME=
# Opt-in: verify a recipient domain actually resolves before reporting a send.
# Without it every syntactically valid address is attempted, even domains that
# have no mail server at all (they would be accepted by SMTP and bounce later).
# EMAIL_DOMAIN_CHECK=1
